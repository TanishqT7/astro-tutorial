---
const pageTitle = "About Me";

const identity = {
	firstName: "SL1M",
	country: "India",
	occupation: "You name it",
	hobbies: ["Content Creation", "Gaming", "Music"]
};

const skills = ["Content Creation", "Video Editing", "Flute", "Programming"]

const happy = true;
const finished = false;
const goals = 3;

const skillColor = "crimson";
const fontWeight = "bold";
const textCase = "uppercase";

---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>{ pageTitle }</title>
		<style define:vars={{skillColor, fontWeight, textCase}}>
			h1 {
				color: purple;
				font-size: 4rem;
			}
			.skill{
				color: var(--skillColor);
				font-weight: var(--fontWeight);
				text-transform: var(--textCase);
			}
		</style>
	</head>
	<body>
		<a href="/">Home</a>
		<a href="/about">About</a>
		<a href="/blogs">Blogs</a>
		<h1>About Me</h1>
		<ul>
			<li>My name is { identity.firstName }</li>
			<li>I live in  { identity.country } and I work as { identity.occupation }</li>
			{ identity.hobbies.length >= 2 &&
				<li>Tow of my hobbies are: {identity.hobbies[0]} and {identity.hobbies[1]}</li>
			}
		</ul>
		<p>My Skills:</p>
		<ul>
			{skills.map((skill) => <li class="skill">{skill}</li>)}
		</ul>

		{happy && <p>I am happy with this project.</p>}
		{finished && <p>I have finished this project.</p>}
		{goals === 3 ? <p>My goal is to finish this project in 3 days.</p>:<p>My goal is not 3 days.</p>}
	</body>
</html>
